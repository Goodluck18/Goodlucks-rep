# Uploaded property images: static files only, never execute anything.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|sh)$">
    Require all denied
</FilesMatch>
