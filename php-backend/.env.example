# ---------------------------------------------------------------------------
# Goodlucks Homes - PHP API configuration
#
# Copy this file to php-backend/.env (or public_html/api/.env) and fill it in.
# The file is git-ignored. Real environment variables always win over this file.
#
# Nothing here is a secret placeholder that works: leave a key empty to disable
# the related integration instead of shipping a fake value.
# ---------------------------------------------------------------------------

# production | development  (development enables verbose API errors)
APP_ENV=production

# Public URL of the website, used in emails and for same-origin checks.
APP_URL=https://rent.goodlucks.co

# Optional comma separated extra origins allowed to call the API.
ALLOWED_ORIGINS=

# --------------------------- Database (MySQL / cPanel) ---------------------
DB_DRIVER=mysql
DB_HOST=localhost
# On cPanel the names are prefixed with your account, e.g. cpuser_goodlucks
DB_NAME=cpuser_goodlucks
DB_USER=cpuser_gluser
DB_PASS=change-me
DB_CHARSET=utf8mb4

# SQLite is for local development and automated tests only.
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=php-backend/local-dev.sqlite

# --------------------------- Uploads ---------------------------------------
# Leave defaults unless your host forces a different writable folder.
# UPLOAD_DIR=/home/cpuser/public_html/api/uploads
UPLOAD_MAX_BYTES=8388608
UPLOAD_URL_PATH=/api/uploads

# --------------------------- Sessions & fees -------------------------------
SESSION_TTL_SECONDS=604800
VIEWING_FEE_GHS=100

# --------------------------- Email -----------------------------------------
# Recommended on shared hosting: Resend API (PHP mail() is the fallback).
RESEND_API_KEY=
RESEND_FROM_EMAIL=rentals@goodlucks.co
OFFICIAL_EMAIL=rentals@goodlucks.co
OFFICIAL_NAME=Goodlucks Homes Intermediary
OFFICIAL_PHONE=+233237690080

# --------------------------- AI (optional) ---------------------------------
# Used for listing descriptions and tenant/property match scoring.
# Without a key the API returns deterministic fallback copy.
GEMINI_API_KEY=

# --------------------------- Retention (cron) -------------------------------
# cron.php prunes these tables; 0 or a negative value keeps everything.
RETENTION_PAGE_VIEW_DAYS=365
RETENTION_EMAIL_LOG_DAYS=180

# --------------------------- Admin console ---------------------------------
# Optional second factor for /api/auth/admin-login. Strongly recommended.
ADMIN_ACCESS_KEY=
