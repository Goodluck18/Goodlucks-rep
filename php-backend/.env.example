# ---------------------------------------------------------------------------
# Goodlucks Homes - PHP API configuration
#
# Copy this file to php-backend/.env (or public_html/api/.env) and fill it in.
# The file is git-ignored. Real environment variables always win over this file.
#
# Nothing here is a secret placeholder that works: leave a key empty to disable
# the related integration instead of shipping a fake value.
# ---------------------------------------------------------------------------

# production | development  (development enables verbose API errors)
APP_ENV=production

# Public origin of the site. Everything the server renders builds its URLs from
# this value: property canonical links, Open Graph / Twitter cards, sitemap.xml,
# alert emails. Use the testing domain while testing (e.g. https://goodlucks.net)
# and the permanent domain in production — no code change, no rebuild.
APP_URL=https://rent.goodlucks.co

# Optional comma separated extra origins allowed to call the API.
ALLOWED_ORIGINS=

# --------------------------- Database (MySQL / cPanel) ---------------------
DB_DRIVER=mysql
DB_HOST=localhost
# On cPanel the names are prefixed with your account, e.g. cpuser_goodlucks
DB_NAME=cpuser_goodlucks
DB_USER=cpuser_gluser
DB_PASS=change-me
DB_CHARSET=utf8mb4

# SQLite is for local development and automated tests only.
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=php-backend/local-dev.sqlite

# --------------------------- Uploads ---------------------------------------
# Leave defaults unless your host forces a different writable folder.
# UPLOAD_DIR=/home/cpuser/public_html/api/uploads
UPLOAD_MAX_BYTES=8388608
UPLOAD_URL_PATH=/api/uploads

# ---------------------- Private identity documents -------------------------
# Identity documents never go in the public uploads folder. Best practice on
# shared hosting is to point this outside public_html entirely:
#   PRIVATE_UPLOAD_DIR=/home/cpuser/private-documents      (chmod 0700)
# The default (php-backend/storage/private) is protected by .htaccess, which
# only works when the host honours AllowOverride.
#PRIVATE_UPLOAD_DIR=
IDENTITY_DOCUMENT_MAX_BYTES=5242880

# AES-256-GCM key for identity-document numbers at rest. Generate with:
#   openssl rand -base64 32
# Leave empty to keep no full number at all (masked value only). Never commit.
IDENTITY_DATA_KEY=

# Days identity documents and numbers are kept after a final decision.
# Placeholder value pending legal advice.
VERIFICATION_RETENTION_DAYS=365

# --------------------------- Sessions & fees -------------------------------
SESSION_TTL_SECONDS=604800
# No platform-wide viewing fee. Each property carries its own approved fee, set
# by the agent and approved with the listing. Leave this unset (0).

# --------------------------- Email -----------------------------------------
# Recommended on shared hosting: Resend API (PHP mail() is the fallback).
RESEND_API_KEY=
RESEND_FROM_EMAIL=rentals@goodlucks.co

# How mail leaves the server. `auto` tries Resend then PHP mail().
# `resend` / `mail` pin a single transport; `none` disables delivery so messages
# only queue (used by the test suite and staging).
EMAIL_TRANSPORT=auto
OFFICIAL_EMAIL=rentals@goodlucks.co
OFFICIAL_NAME=Goodlucks Homes Intermediary
OFFICIAL_PHONE=+233237690080

# Optional email branding. Use publicly reachable HTTPS image/profile URLs.
# EMAIL_LOGO_URL=https://rent.goodlucks.co/assets/goodlucks-homes-logo.png
SOCIAL_FACEBOOK_URL=https://www.facebook.com/GoodlucksHomes
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/GoodlucksHomes
SOCIAL_TIKTOK_URL=https://www.tiktok.com/@GoodlucksHomes
SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/GoodlucksHomes
SOCIAL_X_URL=https://x.com/GoodlucksHomes

# --------------------------- AI (optional) ---------------------------------
# Used for listing descriptions and tenant/property match scoring.
# Without a key the API returns deterministic fallback copy.
GEMINI_API_KEY=

# --------------------------- Retention (cron) -------------------------------
# cron.php prunes these tables; 0 or a negative value keeps everything.
RETENTION_PAGE_VIEW_DAYS=365
RETENTION_EMAIL_LOG_DAYS=180

# --------------------------- Admin console ---------------------------------
# Optional second factor for /api/auth/admin-login. Strongly recommended.
ADMIN_ACCESS_KEY=
