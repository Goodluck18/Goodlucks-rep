# Goodlucks Homes - Root cPanel Apache configuration (.htaccess)
# Copy this file into public_html/ next to index.html.

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS (uncomment once your SSL certificate is active).
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Requests for the PHP API are handled inside /api/ (.htaccess there).
    RewriteCond %{REQUEST_URI} ^/api(/|$) [NC]
    RewriteRule ^ - [L]

    # 2b. The sitemap is generated from the live catalogue by the PHP API.
    RewriteRule ^sitemap\.xml$ api/index.php [L,QSA]

    # 3. Real files and directories (JS, CSS, images, uploads) are served as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Every other URL is a client-side route handled by React Router.
    RewriteRule ^ index.html [L]
</IfModule>

# Hide dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Hashed build assets can be cached aggressively.
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    # Never cache the HTML shell.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header unset X-Powered-By

    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
