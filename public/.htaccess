# Goodlucks Homes - Root cPanel Apache configuration (.htaccess)
# Copy this file into public_html/ next to index.html.

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS (uncomment once your SSL certificate is active).
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Requests for the PHP API are handled inside /api/ (.htaccess there).
    RewriteCond %{REQUEST_URI} ^/api(/|$) [NC]
    RewriteRule ^ - [L]

    # 2b. The sitemap is generated from the live catalogue by the PHP API.
    RewriteRule ^sitemap\.xml$ api/index.php [L,QSA]

    # 2c. Property pages are rendered by PHP so the *initial* HTML response
    #     already carries the listing's own title, price, location, photograph
    #     and canonical URL. WhatsApp, Facebook, X, LinkedIn and Slack do not
    #     run the SPA's JavaScript, so without this they only ever saw the
    #     generic site preview. api/property_page.php also issues the 301 from
    #     old id-only links (/property/prop-1) to the canonical descriptive URL.
    RewriteRule ^property/([A-Za-z0-9._-]+)/?$ api/property_page.php [L,QSA]

    # 2d. The short sharing link (/p/<property-id>) redirects to the canonical
    #     property page. The id is the listing's own stable identifier, so the
    #     link keeps working when the title or price changes, and the resolver
    #     applies the same visibility rule as the property page itself.
    RewriteRule ^p/([A-Za-z0-9_-]+)/?$ api/short_link.php [L,QSA]

    # 3. Real files and directories (JS, CSS, images, uploads) are served as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Every other URL is a client-side route: the app's own router
    #    (src/routing/routes.ts) reads the path and renders the matching page,
    #    or its not-found page for an unknown path. Direct links, bookmarks and
    #    a refresh on /properties, /property/<id>, /tenant/dashboard all land
    #    here and work without a server round trip.
    RewriteRule ^ index.html [L]
</IfModule>

# Hide dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Hashed build assets can be cached aggressively.
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    # Never cache the HTML shell.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header unset X-Powered-By

    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
